# Flask session signing key. Set a long random string before sharing a deployment.
SECRET_KEY=

# Set to 1 to enable the Flask debugger. Leave 0 otherwise.
FLASK_DEBUG=0

# Fernet key used to encrypt files. Leave empty to use the key file below.
ENCRYPTION_KEY=

# Key file used when ENCRYPTION_KEY is empty. Created on first run if missing.
ENCRYPTION_KEY_FILE=myKey.key
